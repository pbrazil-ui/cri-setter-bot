# CRI Setter Bot - environment variables.
# Production: Render > cri-setter-bot > Environment (names mirrored in render.yaml). Never commit real values.
# Local: copy to .env (git-ignored). `npm run dev` needs none of this (all mocks).
# Anything left blank uses the default in src/config.js.

# ---------- Core ----------
# Long random string. Protects /ingest/*, /admin/*, /api/ask, /upload. Generate: openssl rand -hex 24
INGEST_SECRET=
# The Render URL, no trailing slash.
PUBLIC_URL=https://cri-setter-bot.onrender.com
TIMEZONE=America/Los_Angeles
# Optional override of playbook/policies.json test_mode (env wins over the file). Leave blank to use the file.
POLICY_TEST_MODE=
POLICY_EMERGENCY_STOP=

# ---------- Supabase ----------
# supabase.com -> project -> Project Settings -> API (or "Data API"): Project URL + service_role secret key.
# Project ccnybuifsgwwuqasjqmu. Base URL only, no /rest/v1/.
SUPABASE_URL=https://ccnybuifsgwwuqasjqmu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Claude API ----------
# console.anthropic.com -> API Keys -> Create Key. Set a monthly spend limit under Settings -> Limits.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EXTRACT_MODEL=claude-haiku-5-5

# ---------- RingCentral (SMS) ----------
# developers.ringcentral.com -> Console -> your app -> Credentials.
RC_SERVER=https://platform.ringcentral.com
RC_CLIENT_ID=
RC_CLIENT_SECRET=
# Console -> profile menu -> Credentials -> Create JWT (logged in as the user who owns the texting number).
RC_JWT=
# The 10DLC-registered number that texts leads, E.164: +1XXXXXXXXXX
RC_FROM_NUMBER=
# Any random string; RingCentral echoes it on every webhook. Generate: openssl rand -hex 16
RC_VERIFICATION_TOKEN=

# ---------- Owner ----------
# Pierce's cell (approvals, Q#, alerts). E.164. Must NOT be the RingCentral texting number.
OWNER_PHONE=
# Where the full Morning Broker Brief email goes. Pierce confirmed cribrokerage.com is his working address.
OWNER_EMAIL=pbrazil@cribrokerage.com
OWNER_NAME=Pierce Brazil
OWNER_FIRST_NAME=Pierce
COMPANY_NAME=CRI Brokerage
BOOKING_LINK=
CALL_WINDOWS=weekdays 9-10am or 2-4:30pm Pacific
# false = messages go out as Pierce ("this is Pierce over at CRI"), no AI announcement (Pierce, Nov 1 2026).
# The bot still never claims to be human; "are you a bot?" goes to Pierce. Have counsel review (Cal. B&P 17941).
DISCLOSE_AI=false
COMPANY_SHORT=CRI Brokerage

# ---------- Microsoft 365 (Outlook via Graph) ----------
# entra.microsoft.com -> App registrations -> "CRI Setter Bot" -> Overview: Directory (tenant) ID + Application (client) ID.
# Certificates & secrets -> client secret VALUE. NO admin consent: access is Exchange RBAC for Applications scoped to
# pbrazil@cribrokerage.com only (SETUP-PROMPT step 6). Set these only after Test-ServicePrincipalAuthorization passes.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# The mailbox the bot drafts in (Pierce's working address; Dylan is on cricommercial.com).
# One inbox, two addresses. Use the mailbox's sign-in name (UPN) from Entra > Users > Pierce Brazil.
EMAIL_MAILBOX=pbrazil@cribrokerage.com
# Pierce (Nov 2 2026): no cc, not Dylan, not Duane. Leave empty.
EMAIL_ALWAYS_CC=
# send = sends after the policy gate (Pierce: "just send, not draft"; code default). draft = leave in Outlook Drafts.
# On Render keep EMAIL_SEND_MODE=draft and SMS_MODE=mock until /admin/selftest passes, then send / live.
EMAIL_SEND_MODE=send
# Graph-sent mail gets no Outlook signature. Leave unset to use Pierce's (from his my-writing-style skill); set to override.
# EMAIL_SIGNATURE_HTML=
EMAIL_POLL_LEADS=true

# ---------- Dropbox ----------
# dropbox.com/developers/apps -> your app -> Settings: App key + App secret.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# One-time refresh token (run on your Mac, logged in to Dropbox as yourself):
#   1. Open in a browser (replace APP_KEY), click Allow, copy the code it shows:
#      https://www.dropbox.com/oauth2/authorize?client_id=APP_KEY&token_access_type=offline&response_type=code
#   2. In Terminal (replace APP_KEY, APP_SECRET, CODE):
#      curl https://api.dropboxapi.com/oauth2/token -d code=CODE -d grant_type=authorization_code -u APP_KEY:APP_SECRET
#   3. Copy "refresh_token" from the JSON. Codes expire in minutes; if step 2 fails, redo step 1.
DROPBOX_REFRESH_TOKEN=
DROPBOX_LINKS_ALLOW_DOWNLOAD=true

# ---------- HubSpot ----------
# HubSpot SERVICE KEY "CRI Setter Bot" (this account has no private apps); sent as a Bearer token.
# Scopes: crm.objects.contacts.read/write, crm.objects.deals.read/write (+ crm.objects.notes/tasks if the key offers them).
HUBSPOT_TOKEN=
# Pierce's owner ID (read from the portal via MCP, Nov 1 2026; portal 44904909). Not a secret.
HUBSPOT_OWNER_ID=2145826500
HUBSPOT_CREATE_DEALS=true

# ---------- Behavior (defaults are Pierce's; change only on purpose) ----------
AUTO_VERIFY_CREXI_CA=true
# first contact: email 1-2 min after the inquiry, text 4-6 min after the email (random each time)
FIRST_TOUCH_DELAY_MIN_SEC=60
FIRST_TOUCH_DELAY_MAX_SEC=120
TEXT_AFTER_EMAIL_MIN_SEC=240
TEXT_AFTER_EMAIL_MAX_SEC=390
# human pacing: replies 45s-5min, Pierce's A# answers 40s-3min, never two texts to one buyer <45s apart
REPLY_DELAY_MIN_SEC=45
REPLY_DELAY_MAX_SEC=300
PACE_MIN_SEC=40
PACE_MAX_SEC=180
MIN_GAP_SEC=45
REPLY_DELAY_CAP_SEC=480
FOLLOWUP_DAYS=1,3,7
# after day 7: email every 14 days to day 91, then every 30 (elite-cre-sales skill). Texts stop after day 7 unless NURTURE_SMS=true.
NURTURE_EVERY_DAYS=14
NURTURE_UNTIL_DAY=91
NURTURE_MONTHLY_DAYS=30
# Pierce, Nov 2 2026: "email only after this". Keep false.
NURTURE_SMS=false
# call tasks for Pierce in HubSpot: non-urgent ones are due next business day at this hour (Pierce's time)
CALL_TASK_HOUR=9
CREXI_PROFILE_URL=https://www.crexi.com/profile/pierce-brazil-piercebra
FOLLOWUP_DAYS_DD=2,5,10,21
SEND_START_HOUR=8
SEND_END_HOUR=20
SEND_DAYS=1,2,3,4,5,6
BRIEF_HOUR=7
BRIEF_MINUTE=30
